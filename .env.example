# Gemini API key — https://aistudio.google.com/apikey
# v0 uses Gemini 2.5 Flash for both VLM (perceive) and LLM (interpret)
GEMINI_API_KEY=

# Langfuse Cloud (free tier) — https://cloud.langfuse.com -> Settings -> API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Postgres connection string (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://sva:sva_dev_password@localhost:5432/sva

# Redis connection string for Dramatiq queue transport
REDIS_URL=redis://localhost:6379/0

# Comma-separated frontend origins allowed to call the API in production
CORS_ALLOW_ORIGINS=http://localhost:5173
