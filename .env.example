# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Langfuse Cloud (free tier) — https://cloud.langfuse.com -> Settings -> API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Postgres connection string (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://sva:sva_dev_password@localhost:5432/sva
